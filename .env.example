# ── PostgreSQL (Render provides this automatically via render.yaml) ──
# For local dev, point to a local PostgreSQL instance:
DATABASE_URL=postgresql://smogon:smogon@localhost:5432/smogon_rag

# ── Groq LLM API ──
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── JWT Authentication ──
JWT_SECRET_KEY=change-me-to-a-random-secret-string
JWT_EXPIRY_HOURS=24

# ── CORS (set to your Vercel URL in production) ──
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Debug ──
# SHOW_RETRIEVAL_DEBUG=1
